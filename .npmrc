# Disable lifecycle scripts for supply chain security per OWASP recommendations
# https://cheatsheetseries.owasp.org/cheatsheets/NPM_Security_Cheat_Sheet.html#3-minimize-attack-surfaces-by-ignoring-run-scripts
#
# Two transitive dev-dependencies have install scripts (hasInstallScript=true in package-lock.json):
#   - fsevents@2.3.3  – optional, macOS-only native file-watcher; marked optional so npm skips it safely on other platforms
#   - unrs-resolver@1.11.1 – uses napi-postinstall to select a pre-built platform binary from its own optional dependencies
# Both packages continue to work correctly with scripts disabled because the platform-specific binaries
# are shipped as optional dependencies rather than being compiled at install time.
#
# If a future dependency genuinely requires a postinstall script to build native bindings,
# you can override this setting for a single install run:
#   npm install --ignore-scripts=false
# Or set the env variable for one command:
#   npm_config_ignore_scripts=false npm install
ignore-scripts=true
